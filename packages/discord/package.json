{
  "name": "@the-clock/discord",
  "version": "0.1.0",
  "private": true,
  "description": "Blueprint, sincronización y adaptadores de Discord para The Clock.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate:blueprint": "tsx src/blueprint/validate.ts",
    "inspect:guild": "node --env-file=../../.env --import tsx src/inspector/inspect.ts",
    "plan:migration": "tsx src/migration/plan.ts",
    "plan:operations": "tsx src/migration/planOperations.ts",
    "preview:execution": "tsx src/migration/previewExecution.ts",
    "preflight:migration": "node --env-file=../../.env --import tsx src/migration/runPreflight.ts",
    "plan:hierarchy": "tsx src/migration/planHierarchyBootstrap.ts",
    "gate:migration": "tsx src/migration/runMigrationGate.ts",
    "manifest:confirmation": "tsx src/migration/createConfirmationManifest.ts",
    "verify:confirmation": "tsx src/migration/verifyConfirmation.ts",
    "plan:execution-session": "tsx src/migration/planExecutionSession.ts",
    "dry-run:phase": "tsx src/migration/dryRunExecutionPhase.ts",
    "replay:fake-execution": "tsx src/migration/replayFakeExecution.ts",
    "test:execution-checkpoint": "tsx src/migration/testExecutionCheckpoint.ts",
    "test:checkpoint-integrity": "tsx src/migration/testCheckpointIntegrity.ts",
    "test:verified-resume": "tsx src/migration/testVerifiedResume.ts",
    "test:phase-transaction": "tsx src/migration/testPhaseTransaction.ts",
    "test:live-drift": "tsx src/migration/testLiveDrift.ts",
    "test:drift-protected-phase": "tsx src/migration/testDriftProtectedPhase.ts"
  },
  "dependencies": {
    "@the-clock/core": "0.1.0",
    "discord.js": "^14.27.0"
  }
}
