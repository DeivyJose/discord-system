{
  "name": "@the-clock/discord",
  "version": "0.1.0",
  "private": true,
  "description": "Blueprint, sincronización y adaptadores de Discord para The Clock.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate:blueprint": "tsx src/blueprint/validate.ts",
    "inspect:guild": "node --env-file=../../.env --import tsx src/inspector/inspect.ts",
    "plan:migration": "tsx src/migration/plan.ts",
    "plan:operations": "tsx src/migration/planOperations.ts",
    "preview:execution": "tsx src/migration/previewExecution.ts",
    "preflight:migration": "node --env-file=../../.env --import tsx src/migration/runPreflight.ts",
    "plan:hierarchy": "tsx src/migration/planHierarchyBootstrap.ts",
    "gate:migration": "tsx src/migration/runMigrationGate.ts"
  },
  "dependencies": {
    "@the-clock/core": "0.1.0",
    "discord.js": "^14.27.0"
  }
}
