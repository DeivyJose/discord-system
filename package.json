{
  "name": "the-clock",
  "version": "3.0.0",
  "private": true,
  "description": "Ecosistema de The Clock: Compai, API, panel web y servicios compartidos.",
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:compai": "npm run dev --workspace=@the-clock/compai",
    "dev:api": "npm run dev --workspace=@the-clock/api",
    "dev:web": "npm run dev --workspace=@the-clock/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}
