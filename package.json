{
  "name": "the-clock",
  "version": "3.0.0",
  "private": true,
  "description": "Ecosistema de The Clock: Compai, API, panel web y servicios compartidos.",
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:compai": "npm run dev --workspace=@the-clock/compai",
    "dev:api": "npm run dev --workspace=@the-clock/api",
    "dev:web": "npm run dev --workspace=@the-clock/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "inspect:discord": "npm run inspect:guild --workspace=@the-clock/discord",
    "plan:discord": "npm run plan:migration --workspace=@the-clock/discord",
    "plan:discord-operations": "npm run plan:operations --workspace=@the-clock/discord",
    "preview:discord-execution": "npm run preview:execution --workspace=@the-clock/discord",
    "preflight:discord": "npm run preflight:migration --workspace=@the-clock/discord",
    "plan:discord-hierarchy": "npm run plan:hierarchy --workspace=@the-clock/discord"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
